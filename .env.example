# Copy to .env (git-ignored). Everything is optional: collectors run without it
# and skip the steps that need a credential.

# S3 mirror of records/, liens/, courts/ (hoaspy.lib.s3_sync, scripts/s3_push_all.sh)
ACCESSKEYID=
SECRETACCESSKEY=
REGION=us-east-1

# Miami-Dade Clerk Commercial Data Services lookup key (paid, per-request)
MIAMI_DADE_API=

# re:SearchTX session cookie can also be passed as --cookie-file tx_cookie.txt
HW_TXRESEARCH_COOKIE=
